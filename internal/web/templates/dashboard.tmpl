{{define "pagename"}}status{{end}}
{{define "title"}}Status{{end}}
{{define "body"}}
<p class="banner">{{.Banner}}</p>

{{if gt .NotEnforcing 0}}
<p class="flag" role="status">
  {{.NotEnforcing}}
  {{if eq .NotEnforcing 1}}account is{{else}}accounts are{{end}}
  scheduled to be locked out and will not be.
  <a href="/users">Look at the accounts</a>.
</p>
{{end}}

<table class="rows">
  <caption>Every managed account, in the zone its own profile names.</caption>
  <thead>
    <tr>
      <th scope="col">Account</th>
      <th scope="col">Lockout</th>
      <th scope="col">Why</th>
      <th scope="col">Override</th>
      <th scope="col">Sessions</th>
      <th scope="col">Now</th>
      <th scope="col">Diagnose</th>
    </tr>
  </thead>
  <tbody>
    {{- /* Captured outside the range: inside it the dot is a Row, and the row has no
           opinion about whether the read that produced it worked. */ -}}
    {{- $sessionsKnown := .SessionsKnown -}}
    {{range .Rows}}
    <tr class="{{if .LockedOutNow}}held{{end}}{{if .CannotEvaluate}}unreadable{{end}}">
      <th scope="row">{{.Username}}</th>
      <td data-label="Lockout">
        {{- if .CannotEvaluate -}}
          <span class="state-unknown">cannot be decided</span>
        {{- else if .LockedOutNow -}}
          <span class="state-held">locked out</span>
          {{/* `datetime` is the machine-readable instant for the browser; `data-unix`
               is the hook static/app.js counts down from. Both are needed -- the
               script's selector is time[data-unix], and emitting only the standard
               attribute ships a countdown that never runs.

               No trim markers here, deliberately: this comment sits between the state
               and its deadline, and trimming both sides deletes the only space between
               them, so the cell renders "locked outuntil 06:30". */}}
          {{if not .EndsAt.IsZero}}until <time datetime="{{.EndsAt.Format "2006-01-02T15:04:05Z07:00"}}" data-unix="{{.EndsAt.Unix}}">{{.EndsAtClock}}</time>{{end}}
        {{- else if .ScheduledButNotEnforcing -}}
          <span class="state-gap">scheduled, not enforced</span>
        {{- else if not .NextLockAt.IsZero -}}
          not now; next at {{.NextLockAtClock}}
        {{- else -}}
          nothing scheduled
        {{- end -}}
      </td>
      <td data-label="Why">
        {{if .RuleName}}<span class="rule">{{.RuleName}}</span>{{end}}
        {{if .OverrideActive}}<span class="override">open override{{if .OverrideReason}}: {{.OverrideReason}}{{end}}</span>{{end}}
        {{if .OverrideExpired}}<span class="override-expired">override expired</span>{{end}}
        {{if not .Enabled}}<span class="disabled">account switched off</span>{{end}}
        {{range .Problems}}<span class="problem">{{.}}</span>{{end}}
      </td>
      {{- /* The override control, and the reason it is a plain POST form.
             The handler at these two routes is the only way an override is granted from
             the web layer, and until now nothing on any page posted to it -- the buttons
             the ticket describes were never in the markup, so the write path was reachable
             only by hand-crafted requests. A form rather than a fetch() call because the
             CSRF layer reads the `csrf` body field, and a form carries it with no script
             involved; app.js's header path stays the JS route's option, not this one's
             requirement.

             No maxlength on the reason field. The server bounds it at maxOverrideReason
             and refuses with the limit named; repeating the number here would be a second
             home for a constant that a test does not tie the two together on. */ -}}
      <td data-label="Override">
        {{- $who := .Username -}}
        {{if .OverrideActive}}
        <form method="post" action="/users/{{$who}}/override/clear">
          {{with $.CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}
          <button type="submit">Take the override away</button>
        </form>
        {{else}}
        <form method="post" action="/users/{{$who}}/override">
          {{with $.CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}
          <label>Reason for letting {{$who}} out
            <input type="text" name="reason" autocomplete="off">
          </label>
          <button type="submit" name="minutes" value="15">15 min</button>
          <button type="submit" name="minutes" value="30">30 min</button>
          <button type="submit" name="minutes" value="60">60 min</button>
          <button type="submit" name="scope" value="window">until the window ends</button>
        </form>
        {{end}}
      </td>
      <td data-label="Sessions">
        {{if .Sessions}}
        <ul class="sessions">
          {{range .Sessions}}
          <li>{{.Type}}{{with .Seat}} · {{.}}{{end}}{{if .Locked}} · locked{{else}} · unlocked{{end}}</li>
          {{end}}
        </ul>
        {{else if $sessionsKnown}}
          <span class="state-unknown">no desktop session</span>
        {{else}}
          <span class="state-unknown">session list unavailable</span>
        {{end}}
      </td>
      {{- /* Lock now, per row. A form rather than a fetch() call for the same reason the
             override above is one: the CSRF gate reads the `csrf` body field and a form
             carries it with no script involved. Per row rather than one page-wide button
             because the operator has to see whose screen is about to go down before it
             does -- and because a "lock everyone" control on a page that lists everyone is
             one careless click away from locking the parent's own session. The CLI has that
             control, and says so in its own help text; this page deliberately does not.

             It is always offered, even on a row that shows no session. The session list on
             this page was read when the page was built, and a control that disappears and
             reappears with a stale read is worse than a request that answers "has no
             session on this machine" and says which machine it asked. */ -}}
      <td data-label="Now">
        <form method="post" action="/users/{{.Username}}/lock-now">
          {{with $.CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}
          <button type="submit">Lock now</button>
        </form>
      </td>
      {{- /* The probe, beside the action it explains. An operator who just read "locked out
             now" and doubts it needs to ask the machine without leaving this page -- and the
             asking must be safe to do while the child is using the screen, which is exactly
             why this route locks nothing (see handleTestLock). Two buttons in one row is a
             real risk, so they are in separate cells under different headings and the probe
             is the one that says "Check" rather than "Lock" in its label. */ -}}
      <td data-label="Diagnose">
        <form method="post" action="/users/{{.Username}}/test-lock">
          {{with $.CSRF}}<input type="hidden" name="csrf" value="{{.}}">{{end}}
          <button type="submit">Check backends</button>
        </form>
      </td>
    </tr>
    {{else}}
    <tr><td colspan="7">No accounts are managed yet.</td></tr>
    {{end}}
  </tbody>
</table>
{{end}}
