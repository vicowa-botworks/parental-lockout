{{define "pagename"}}profiles{{end}}
{{define "title"}}Lockout profiles{{end}}
{{define "body"}}
<p class="banner">
  {{if not .Manage}}
    <span class="problem">Enforcement is switched off, so a rule added here changes the
    configuration but locks nobody out until it is switched back on.</span>
  {{else if not .Profiles}}
    There are no profiles yet, so no account can be locked out.
  {{else}}
    A profile is the set of windows that lock a child out. Several accounts can share one.
  {{end}}
</p>

{{- /* The sentence from a refused write, above everything on the page. It is not beside the
       form that produced it, because the form that produced it is one of five and the parent
       finds the sentence first and the box second (#138). The id is for the same reason the
       boxes have ids: the row below can also carry a problem sentence, and a test that took the
       first one in the document would be reading the evaluator rather than the refusal. */ -}}
{{if .Notice}}
<p id="refusal" class="problem" role="alert">{{.Notice}}</p>
{{end}}

{{- /* Creating a profile sits above the list rather than inside it, because the list is empty
       on a machine that has never had one -- and an empty list with no way out is the whole
       reason this form exists. It is outside the range for the same reason: {{.}} here is the
       page, so the field ids cannot collide with a profile's. */ -}}
<section class="profile create-profile">
  <h2>Add a profile</h2>
  <form method="post" action="/profiles" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <p>
      <label for="new-profile-name">Name</label>
      <input id="new-profile-name" type="text" name="name" required placeholder="Weekend rules"
             value="{{if .Create}}{{.Create.Name}}{{end}}">
    </p>
    <p>
      <label for="new-profile-tz">Timezone</label>
      <input id="new-profile-tz" type="text" name="timezone" required placeholder="Europe/Paris"
             value="{{if .Create}}{{.Create.Timezone}}{{end}}">
    </p>
    <button type="submit">Create profile</button>
    <p class="muted">
      Every window added to it is read in this zone, so pick the zone the household lives in.
      The profile starts with no windows and no accounts, which locks nobody out until you add
      both. Its id is made from the name.
    </p>
  </form>
</section>

{{range $row := .Profiles}}
<section class="profile">
  <h2>{{if .Name}}{{.Name}}{{else}}{{.ID}}{{end}}</h2>
  <p class="meta">
    id <code>{{.ID}}</code> &middot; timezone <code>{{.Timezone}}</code>
  </p>

  {{- /* The two labels on the profile, each beside the line that shows it. The timezone is
         not cosmetic: every window below is read in it, so a wrong zone enforces the right
         clock at the wrong hours. */ -}}
  <form method="post" action="/profiles/{{.ID}}/rename" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <p>
      <label for="rename-{{.ID}}">Rename this profile</label>
      {{- /* The current name is what the box holds on a normal load; the typed one is what it
             holds after a refusal, so the parent edits what they wrote instead of retyping it
             from memory (#138). */ -}}
      <input id="rename-{{.ID}}" type="text" name="name"
             value="{{if .EchoRename}}{{.EchoRename}}{{else}}{{.Name}}{{end}}" required>
      <button type="submit">Save name</button>
    </p>
  </form>

  <form method="post" action="/profiles/{{.ID}}/timezone" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <p>
      <label for="tz-{{.ID}}">Timezone</label>
      <input id="tz-{{.ID}}" type="text" name="timezone" required placeholder="Europe/Paris"
             value="{{if .EchoZone}}{{.EchoZone}}{{else}}{{.Timezone}}{{end}}">
      <button type="submit">Save timezone</button>
    </p>
    <p class="muted">
      Every window below is read in this zone, so changing it moves when the account is
      actually locked.
    </p>
  </form>

  {{- /* The evaluator's own degraded report. A profile whose rule can never fire, or whose
         timezone fell back to a default, would otherwise look exactly like one that works. */ -}}
  {{if .Complaint}}
  <p class="problem" role="alert">{{.Complaint}}</p>
  {{end}}

  <table class="rows">
    <caption>
      Windows enforced by {{if .Name}}{{.Name}}{{else}}{{.ID}}{{end}},
      and which accounts share them.
    </caption>
    <thead>
      <tr>
        <th scope="col">Rule</th>
        <th scope="col">Days</th>
        <th scope="col">Window</th>
      </tr>
    </thead>
    <tbody>
      {{range .Rules}}
      <tr>
        <th scope="row">{{if .Name}}{{.Name}}{{else}}{{.ID}}{{end}}</th>
        <td data-label="Days">{{if .Days}}{{.Days}}{{else}}<span class="problem">no day</span>{{end}}</td>
        <td data-label="Window">{{.Window}}</td>
      </tr>
      {{else}}
      <tr><td colspan="3">No windows yet, so this profile locks nobody out.</td></tr>
      {{end}}
    </tbody>
  </table>

  <p class="assigned">
    {{if .AssignedTo}}
      Shared by:
      {{range $i, $u := .AssignedTo}}{{if $i}}, {{end}}<code>{{$u}}</code>{{end}}
    {{else}}
      <span class="muted">No account is assigned to this profile.</span>
    {{end}}
  </p>

  <form method="post" action="/profiles/{{.ID}}/rules" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <h3>Add a window</h3>

    <p>
      <label for="name-{{.ID}}">Name</label>
      <input id="name-{{.ID}}" type="text" name="name" required placeholder="School night"
             value="{{if .EchoRule}}{{.EchoRule.Name}}{{end}}">
    </p>

    <fieldset>
      <legend>Days</legend>
      {{range $.Days}}
      {{- /* HasDay is nil-safe, so this line renders on every load and not only on a refusal.
             Seven checkboxes lost to a refusal about a clock is the case #138 is about. */ -}}
      <label><input id="days-{{.}}-{{$row.ID}}" type="checkbox" name="days" value="{{.}}"
             {{if $row.EchoRule.HasDay .}}checked{{end}}> {{.}}</label>
      {{end}}
    </fieldset>

    <p>
      <label for="start-{{.ID}}">From</label>
      <input id="start-{{.ID}}" type="text" name="start" inputmode="numeric"
             placeholder="21:00" size="5" value="{{if .EchoRule}}{{.EchoRule.Start}}{{end}}">
      <label for="end-{{.ID}}">Until</label>
      <input id="end-{{.ID}}" type="text" name="end" inputmode="numeric"
             placeholder="06:30" size="5" value="{{if .EchoRule}}{{.EchoRule.End}}{{end}}">
    </p>

    <p>
      <label for="allday-{{.ID}}">
        <input id="allday-{{.ID}}" type="checkbox" name="allDay" value="on"
               {{if .EchoRule.Checked}}checked{{end}}>
        All day &mdash; the times above are then ignored
      </label>
    </p>

    <button type="submit">Add window</button>
  </form>

  {{- /* The copy carries the source's timezone and does not offer one. A rule is a wall-clock
         time, so taking a different zone while carrying the same rule text would move every
         window by the offset between the zones and still look identical to the profile it came
         from. The zone is changed afterwards, on the copy's own row, beside the sentence that
         says what moving it does. */ -}}
  <form method="post" action="/profiles/{{.ID}}/copy" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <p>
      <label for="copy-{{.ID}}">Copy this profile</label>
      <input id="copy-{{.ID}}" type="text" name="name" required
             placeholder="Same windows, other child" value="{{if .EchoCopy}}{{.EchoCopy}}{{end}}">
      <button type="submit">Create copy</button>
    </p>
    <p class="muted">
      The copy starts with {{if eq (len .Rules) 0}}no windows{{else}}the same {{len .Rules}} window{{if gt (len .Rules) 1}}s{{end}}{{end}},
      read in <code>{{.Timezone}}</code>, and no account assigned to it. Change the zone on the
      copy's own row if the other child lives by different hours.
    </p>
  </form>

  <form method="post" action="/profiles/{{.ID}}/delete" class="edit-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <p>
      <button type="submit">Delete this profile</button>
      <span class="muted">
        Refused while an account is still assigned to it, naming every account that has to
        move first.
      </span>
    </p>
  </form>
</section>
{{else}}
<p>Nothing is configured yet.</p>
{{end}}
{{end}}
