# Build output
/bin/

# A cross-compile check (`GOOS=windows go build ./cmd/plock`) drops the binary in the
# tree next to the package it built. It is not an artefact anybody wants tracked.
*.exe

# The same artefact with no extension at all, which is what `go build ./cmd/plock`
# leaves on a unix host. It has been committed twice by `git add -A` after a build
# run to check a mutation compiles, and a 10 MB binary in a PR is not reviewable.
/plock

# Test and coverage artefacts
*.test
*.out
coverage.*

# `python3 -m py_compile scripts/check-mutations.py` leaves this behind. The two tools
# run as scripts and create nothing on their own, but every other tool artefact in this
# file is here because it was swept into a commit by `git add -A`, and the ignore is
# cheaper than the memory.
__pycache__/

# Local agent state (Magic Context session/note storage). Never part of the
# project; it was swept in by `git add -A` twice, which is why it is ignored rather
# than remembered.
.cortexkit/

# Editor noise
*.swp
.idea/
.vscode/

# Local agent state (Magic Context); never part of the project
.cortexkit/

# Manual e2e runs write a transcript, the daemon's log and a copy of /etc/plock into a
# timestamped directory here. A transcript names a user, a host and a session id, and a
# backup of /etc/plock is a copy of the admin credential hash -- neither belongs in a
# commit, and both are produced by the same `git add -A` that has swept this file's other
# entries in.
testing/e2e/runs/

# `check-mutations.py` imports scripts/mutset.py, which drops a __pycache__ beside the
# source on every run. It is generated, it changes with the Python version, and a bulk
# `git add -A` in a moment of haste would commit it.
__pycache__/
