// Project OpenCode configuration.
//
// Why this file exists: the delivery supervisor starts sessions with `opencode run`, where nobody
// is present to answer a permission prompt or a `question`. Two tools make a headless run stop
// forever -- an approval it cannot ask for, and a question it cannot answer -- and both are bounded
// here rather than by hoping the model behaves.
//
// `--auto` on the command line approves permissions that are not explicitly denied. That is why the
// deny list below is the actual boundary: everything not named is allowed, and everything named is
// refused no matter what flag was passed. It is a short list on purpose -- each entry is an action
// whose result cannot be undone by reverting a commit.
//
// The agent is `factory`, named by `factory/factory.sh` through FACTORY_AGENT.
{
	"$schema": "https://opencode.ai/config.json",
	"agent": {
		"factory": {
			"description": "One unit of delivery work, unattended: implement, verify, open the pull request. Never merge.",
			"permission": {
				// The tool that stops a headless session dead. It "pauses execution and presents
				// the question to the user", and `opencode run` renders no question UI, so a tick
				// that calls it holds its worktree until the wall-clock ceiling kills it -- with no
				// reason recorded anywhere. Denied, the call returns an error to the model instead,
				// and the skill's decision procedure is what it does next: write the entry, take the
				// recommended option, carry on.
				"question": "deny",
				// Merging is `factory.sh`'s job: it re-reads reviewDecision, mergeable,
				// mergeStateStatus and every check from the API immediately before merging, and
				// refuses unless all four still say yes. A tick does none of that reliably.
				"gh pr merge": "deny",
				"gh pr review": "deny",
				// A push of a branch is expected and is how a tick's work survives it. These are the
				// push shapes that destroy other people's work.
				"git push --force*": "deny",
				"git push -f*": "deny",
				"git push --delete*": "deny",
				"git push origin main*": "deny",
				"git push origin master*": "deny",
				// The dependency rule (#856): a `require` line is the user's decision, full stop.
				"go get*": "deny",
				// A release is a public act, and this repository publishes from a tag.
				"git tag*": "deny",
				"gh release*": "deny",
				// A stopped machine is a bigger incident than a stalled ticket.
				"systemctl*": "deny",
				"rm -rf /*": "deny"
			}
		}
	}
}
