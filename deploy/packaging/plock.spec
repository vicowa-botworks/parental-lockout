# plock.spec -- the .rpm recipe.
#
# Written by hand rather than generated by fpm or a Go-Releaser template, for the reason
# that governs everything under deploy/: whoever installs this is running a root daemon
# that locks other people's sessions, and the file that decides what lands where should be
# readable on its own terms.
#
# It does not build anything. The binary comes from `make build` and the tree comes from
# deploy/install.sh -- scripts/package-rpm.sh stages both and points %install at the
# result. That is deliberate: the spec is a second reader of the installer's decisions,
# not a second author of them.
#
# Versions, release and arch arrive from the caller:
#   --define "plock_version 0.3.0"
#   --define "plock_release 1.12.ga1b2c3d"
#   --define "plock_arch x86_64"
#   --define "plock_payload /path/to/staged/root"

Name:           plock
Version:        %{plock_version}
Release:        %{plock_release}%{?dist}
Summary:        Parental screen-lockout daemon
License:        MIT
URL:            https://github.com/vicowa-botworks/parental-lockout
BuildArch:      %{plock_arch}

# AutoReqProv: no. The binary is statically linked (CGO_ENABLED=0), so rpm's dependency
# generator would derive requirements from a Go binary's ELF notes and produce a
# dependency on a glibc version the program never loads. A wrong automatic requirement is
# worse than none: it refuses installs on machines that would work.
AutoReqProv:    no
Requires:       systemd
Requires(post): systemd
Requires(preun): systemd
Requires(postun): systemd

# Go emits .note.go.buildid, not .note.gnu.build-id, and Fedora's build-id check treats a
# package with no GNU build-id as an error. Disabling the check is the honest fix here --
# the alternative is a stripped binary that no longer matches the source for a debugger,
# which buys nothing for a Go program.
%global debug_package %{nil}
%global _missing_build_ids_terminate_build 0

# rpm's install post-processing strips the ELF files it finds. On a binary this project
# already built with `-s -w` there is nothing left to take out, and what strip does instead
# is rewrite the file: same sections, same sizes, a different section-table offset, 1016
# bytes of padding. Measured on the first build of this spec -- the .deb's binary and the
# .rpm's differed at byte 41 with identical build info.
#
# That is not cosmetic here. The claim this repo needs is that the .deb and the .rpm carry
# the same program, and a package manager that edits the payload makes it false: the hash an
# operator verifies, the hash `debsums` reports, and the hash in a security advisory would
# all name different files for one release. So the payload ships exactly as it was built.
%global __strip /bin/true

# Fedora's default takes the package build time from %changelog. This package has no
# changelog section -- the history is the git log the artifact is stamped with, and a
# hand-maintained changelog beside it is a second source of truth that will disagree first.
# So the build time comes from SOURCE_DATE_EPOCH, which scripts/package-rpm.sh exports from
# the commit, and a rebuild of one commit does not differ by the clock.
%global source_date_epoch_from_changelog 0

%description
plock enforces lockout periods on the accounts of a shared Linux desktop: it holds a
child's session locked outside the hours the operator allows, re-asserting the lock on
every tick so nothing the controlled account can write decides when enforcement stops.

The daemon runs as root precisely so the controlled account cannot turn it off.

%prep
# Nothing to unpack: the payload is already staged by deploy/install.sh.

%build
# Nothing to compile: `make build` produced the binary, with the version stamp from the
# same git tree this spec came from.

%install
rm -rf %{buildroot}
mkdir -p %{buildroot}
# -a preserves the modes install.sh set, which is the point: /etc/plock has to arrive 0700
# because the policy inside it holds the admin credential.
cp -a %{plock_payload}/. %{buildroot}/

# The state and log directories are created by %post rather than shipped, so that erasing
# the package cannot delete an audit trail or a private key. See the note in
# deploy/packaging/deb/postrm: the trail is the record someone may need *because* the
# daemon is coming off the machine.

%files
%defattr(-,root,root,-)
%dir %attr(0700,root,root) /etc/plock
%attr(0755,root,root) /usr/local/bin/plock
# The unit is in /etc/systemd/system rather than %_unitdir, matching deploy/install.sh and
# the .deb. Distro policy says a package's unit belongs under /usr/lib, and it is usually
# right. Here the paths are product documentation: docs/setup.md, `systemctl status plock`
# and the unit's own Documentation= line all name /etc/systemd/system/plock.service, and a
# package that installed it somewhere else would ship a machine whose files disagree with
# its own manual. The trade is recorded rather than unnoticed.
%attr(0644,root,root) /etc/systemd/system/plock.service
%attr(0644,root,root) /usr/share/doc/plock/docs/*.md
%dir /usr/share/doc/plock
%dir /usr/share/doc/plock/docs

%post
# Mirrors deploy/packaging/deb/postinst. The two files are kept in step by
# scripts/package-verify.sh, which installs both formats and compares what each one did --
# a test that can see drift is worth more here than a shared file neither format can run.
#
# Never enabled, never started: see the header of deploy/install.sh for why an installer
# for this program prints the command instead of running it.
if [ -x /usr/bin/systemctl ] && [ -d /run/systemd/system ]; then
  /usr/bin/systemctl daemon-reload || :
fi
for pair in "0700 /etc/plock" "0700 /var/lib/plock" "0750 /var/log/plock"; do
  mode=${pair%% *}
  dir=${pair#* }
  # Only when absent. A directory that already exists belongs to whoever made it, and a
  # package chmodding it on upgrade is an arbitrary-chmod primitive with a root scriptlet
  # holding the descriptor.
  if [ ! -d "$dir" ]; then
    install -d -m "$mode" -o root -g root "$dir"
  fi
done

cat <<'GUIDE'

plock is installed but nothing is running, and nothing will start until you say so.

There is no policy file yet. Create one, naming the account and reading the password off
stdin so it never appears in argv or your shell history:

    plock init --username YOUR_LOGIN --password-stdin

Then check this machine can actually lock its screen before you make it a service:

    plock doctor

Start it when you are ready:

    systemctl enable --now plock

GUIDE

%preun
# $1 == 0 is an erase, not an upgrade. Stopping on erase is right -- a daemon whose binary
# has just been deleted is not a daemon, it is a crash loop. Stopping on upgrade is not:
# it would unlock every screen this daemon is holding, in the middle of whatever evening it
# happens to be, because a package was updated.
if [ "$1" -eq 0 ] && [ -x /usr/bin/systemctl ] && [ -d /run/systemd/system ]; then
  /usr/bin/systemctl stop plock || :
  /usr/bin/systemctl disable plock || :
fi

%postun
if [ -x /usr/bin/systemctl ] && [ -d /run/systemd/system ]; then
  /usr/bin/systemctl daemon-reload || :
fi
# rpm has no purge. Erase is therefore treated as `remove`, and every byte of state
# survives: the policy, the credential, the key and the trail. Deleting a family's rules
# because someone typed `dnf remove plock` is not what the word promises, and there is no
# second command that would have warned them first.
if [ "$1" -eq 0 ]; then
  kept=
  for dir in /etc/plock /var/lib/plock /var/log/plock; do
    [ -d "$dir" ] && kept="$kept $dir"
  done
  if [ -n "$kept" ]; then
    printf 'plock was removed. These were left in place:%s\n' "$kept" >&2
    printf 'They hold the policy, the admin credential, the private key and the audit trail,\n' >&2
    printf 'so a reinstall does not have to rebuild a family%s rules. Delete them if you are\n' "'s" >&2
    printf 'sure nobody needs the record: rm -rf%s\n' "$kept" >&2
  fi
fi
